{
  "schemaVersion": 1,
  "id": "fatekings",
  "version": "${version}",
  "name": "Fate · 英灵 (Heroic Spirits)",
  "description": "Fate 英灵 Mod：穿齐一套装备即成为对应的英灵，宝具拿到即满级、右键使用。黄金铠甲——英雄王吉尔伽美什（王之财宝、王律键与乖离剑 Ea、天之锁、维摩那）；骑士王铠甲——阿尔托利亚（誓约胜利之剑、风王结界、魔力放出、遥远的理想乡）；红色圣骸布——卫宫·红 Archer（黑弓与伪·螺旋剑、干将·莫邪、炽天覆七重圆环、投影魔术与固有结界·无限剑制）。含三位英灵的刷怪蛋 NPC、宿敌对决与宝具对撞。可与「咒术回战：五条悟 × 两面宿傩」Mod 同装并互相兼容。",
  "authors": [
    "RoyceBella-commits"
  ],
  "contact": {},
  "license": "MIT",
  "icon": "assets/fatekings/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "cn.blockforge.fatekings.FateKings"
    ],
    "client": [
      "cn.blockforge.fatekings.FateKingsClient"
    ]
  },
  "mixins": [
    "fatekings.mixins.json",
    "fatekings.client.mixins.json",
    "fatekings.compat.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "26.3",
    "java": ">=25",
    "fabric-api": ">=0.161.0"
  },
  "suggests": {
    "sukuna": "*"
  },
  "accessWidener": "fatekings.accesswidener"
}
